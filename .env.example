# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Onde achar: Supabase > Project Settings > API (ou "Connect" no topo do painel).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...) — a antiga "anon key" também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
