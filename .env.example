# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# Onde achar: Supabase > Project Settings > API (ou "Connect" no topo do painel).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Publishable key (sb_publishable_...) — a antiga "anon key" também funciona aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Só no servidor (webhook da Cakto). Configure na Vercel; NUNCA compartilhe nem suba para o GitHub. ---
# Secret key do Supabase (sb_secret_...) — Project Settings > API Keys
SUPABASE_SECRET_KEY=
# Segredo do webhook — Cakto > Apps > Webhooks (campo "secret" do webhook criado)
CAKTO_WEBHOOK_SECRET=
